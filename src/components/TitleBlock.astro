---
interface Props {
  title: string;
  dwg: string;
  date: string;
  rev: string;
  sheet: string;
}
const { title, dwg, date, rev, sheet } = Astro.props;
const cells: [string, string][] = [
  ['Title', title.toUpperCase()],
  ['DWG', dwg],
  ['Date', date],
  ['Rev', rev],
  ['Scale', '1:1'],
  ['Sheet', sheet],
];
---

<dl class="tblock" aria-label="Title block">
  {cells.map(([k, v]) => <div><dt>{k}</dt><dd>{v}</dd></div>)}
</dl>

<style>
  .tblock {
    display: grid;
    grid-template-columns: 1.6fr repeat(5, minmax(0, 1fr));
    margin: 0;
    border: 1.5px solid var(--ink);
    width: min(100%, 640px);
    background: var(--paper);
  }
  .tblock div {
    padding: 6px 8px;
    border-left: 1px solid var(--ink);
    display: grid;
    gap: 2px;
    min-width: 0;
  }
  .tblock div:first-child {
    border-left: 0;
  }
  dt {
    font: 9.5px var(--font-mono);
    letter-spacing: 0.08em;
    color: var(--pm);
    text-transform: uppercase;
  }
  dd {
    margin: 0;
    font: 500 12px var(--font-mono);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  @media (max-width: 639px) {
    .tblock {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
    .tblock div:nth-child(4) {
      border-left: 0;
    }
    .tblock div:nth-child(n + 4) {
      border-top: 1px solid var(--ink);
    }
  }
</style>
