---
import { site } from '../config/site';

interface Props {
  project: string;
  sheet: string;
  date: string;
}
const { project, sheet, date } = Astro.props;
---

<dl class="hdr">
  <div class="name"><dt>Drawn by</dt><dd>{site.name}</dd></div>
  <div><dt>Project</dt><dd>{project}</dd></div>
  <div><dt>Sheet</dt><dd>{sheet}</dd></div>
  <div><dt>Date</dt><dd><time datetime={date}>{date}</time></dd></div>
</dl>

<style>
  .hdr {
    display: grid;
    grid-template-columns: 1.6fr 1.2fr 0.7fr 1fr;
    margin: 0;
    border: 1.5px solid var(--ink);
    background: var(--paper);
  }
  .hdr div {
    padding: 6px 10px;
    border-left: 1px solid var(--ink);
    display: grid;
    gap: 2px;
    min-width: 0;
  }
  .hdr div:first-child {
    border-left: 0;
  }
  dt {
    font: 9.5px var(--font-mono);
    letter-spacing: 0.08em;
    color: var(--pm);
    text-transform: uppercase;
  }
  dd {
    margin: 0;
    font: 500 13px var(--font-mono);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .name dd {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 15px;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }
  @media (max-width: 639px) {
    .hdr {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
    .hdr div:nth-child(3) {
      border-left: 0;
    }
    .hdr div:nth-child(n + 3) {
      border-top: 1px solid var(--ink);
    }
  }
</style>
